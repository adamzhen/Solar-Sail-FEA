mdb.models['Model-1'].parts['SMAWire'].setElementType(elemTypes=(ElemType(
    elemCode=B31H, elemLibrary=STANDARD), ), regions=(
    mdb.models['Model-1'].parts['SMAWire'].edges, ))
mdb.models['Model-1'].parts['SMAWire'].generateMesh()
mdb.models['Model-1'].rootAssembly.DatumCsysByDefault(CARTESIAN)
mdb.models['Model-1'].rootAssembly.Instance(dependent=ON, name='Hub-1', part=
    mdb.models['Model-1'].parts['Hub'])
mdb.models['Model-1'].rootAssembly.Instance(dependent=ON, name='SMAWire-1', 
    part=mdb.models['Model-1'].parts['SMAWire'])
mdb.models['Model-1'].StaticStep(description='Static drag load on wire', 
    initialInc=0.001, maxInc=0.05, maxNumInc=1000, minInc=1e-08, name=
    'Step-400', nlgeom=ON, previous='Initial')
mdb.models['Model-1'].steps['Step-400'].Restart(frequency=1, numberIntervals=0, 
    overlay=ON)
mdb.models['Model-1'].EncastreBC(createStepName='Step-400', name='WireFixed', 
    region=
    mdb.models['Model-1'].rootAssembly.instances['SMAWire-1'].sets['WireFixed'])
mdb.models['Model-1'].ExpressionField(description=
    'Arc length s along wire from hub attachment point', expression=
    '(-0.01148050 + X * -1.00000000 + Y * 0.00000000)', localCsys=None, name=
