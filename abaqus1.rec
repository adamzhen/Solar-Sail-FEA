    -0.454509, 0.027716, 0.0), ), ), name='WireEdges')
mdb.models['Mesh_3'].LineLoad(comp3=-0.00648033497199178, createStepName=
    'DragStep', distributionType=FIELD, field='DragField', name='DragLoad', 
    region=mdb.models['Mesh_3'].rootAssembly.sets['WireEdges'])
