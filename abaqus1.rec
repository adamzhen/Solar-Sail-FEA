mdb.models['Mesh_3'].parts['SMAWire'].setElementType(elemTypes=(ElemType(
    elemCode=B31H, elemLibrary=STANDARD), ), regions=(
    mdb.models['Mesh_3'].parts['SMAWire'].edges, ))
mdb.models['Mesh_3'].parts['SMAWire'].generateMesh()
mdb.models['Mesh_3'].rootAssembly.DatumCsysByDefault(CARTESIAN)
mdb.models['Mesh_3'].rootAssembly.Instance(dependent=ON, name='Hub-1', part=
    mdb.models['Mesh_3'].parts['Hub'])
mdb.models['Mesh_3'].rootAssembly.Instance(dependent=ON, name='SMAWire-1', 
    part=mdb.models['Mesh_3'].parts['SMAWire'])
mdb.models['Mesh_3'].StaticStep(description='Static drag load on wire', 
    initialInc=0.001, maxInc=0.05, maxNumInc=1000, minInc=1e-08, name=
    'DragStep', nlgeom=ON, previous='Initial')
mdb.models['Mesh_3'].EncastreBC(createStepName='DragStep', name='WireFixed', 
    region=
    mdb.models['Mesh_3'].rootAssembly.instances['SMAWire-1'].sets['WireFixed'])
mdb.models['Mesh_3'].ExpressionField(description=
    'Arc length s along wire from hub attachment point', expression=
    '(-0.01148050 + X * -1.00000000 + Y * 0.00000000)', localCsys=None, name=
    'DragField')
mdb.models['Mesh_3'].rootAssembly.Set(edges=
