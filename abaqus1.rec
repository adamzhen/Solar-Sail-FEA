mdb.models['Model-1'].parts['Hub'].setMeshControls(elemShape=TET, regions=
    mdb.models['Model-1'].parts['Hub'].cells, technique=FREE)
mdb.models['Model-1'].parts['Hub'].setElementType(elemTypes=(ElemType(
    elemCode=C3D10, elemLibrary=STANDARD), ElemType(elemCode=C3D6, 
    elemLibrary=STANDARD), ElemType(elemCode=C3D4, elemLibrary=STANDARD)), 
    regions=(mdb.models['Model-1'].parts['Hub'].cells, ))
mdb.models['Model-1'].parts['Hub'].generateMesh()
mdb.models['Model-1'].parts['SMAWire'].seedPart(deviationFactor=0.1, 
