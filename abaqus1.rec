mdb.models['Mesh_3'].parts['Hub'].setMeshControls(elemShape=TET, regions=
    mdb.models['Mesh_3'].parts['Hub'].cells, technique=FREE)
mdb.models['Mesh_3'].parts['Hub'].setElementType(elemTypes=(ElemType(
    elemCode=C3D10, elemLibrary=STANDARD), ElemType(elemCode=C3D6, 
    elemLibrary=STANDARD), ElemType(elemCode=C3D4, elemLibrary=STANDARD)), 
