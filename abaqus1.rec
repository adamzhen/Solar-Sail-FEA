mdb.models['Model-1'].Part(dimensionality=THREE_D, name='Hub', type=
    DEFORMABLE_BODY)
mdb.models['Model-1'].parts['Hub'].BaseSolidExtrude(depth=0.09, sketch=
    mdb.models['Model-1'].sketches['__profile__'])
del mdb.models['Model-1'].sketches['__profile__']
mdb.models['Model-1'].ConstrainedSketch(name='__profile__', sheetSize=10.0)
mdb.models['Model-1'].sketches['__profile__'].Line(point1=(-0.0114805029709527, 
    0.0277163859753386), point2=(-1.78359533451059, 0.0277163859753386))
mdb.models['Model-1'].Part(dimensionality=THREE_D, name='SMAWire', type=
    DEFORMABLE_BODY)
mdb.models['Model-1'].parts['SMAWire'].BaseWire(sketch=
    mdb.models['Model-1'].sketches['__profile__'])
del mdb.models['Model-1'].sketches['__profile__']
mdb.models['Model-1'].Material(name='Nitinol')
mdb.models['Model-1'].materials['Nitinol'].Density(table=((6450.0, ), ))
mdb.models['Model-1'].materials['Nitinol'].Elastic(table=((35000000000.0, 0.3), 
    ))
mdb.models['Model-1'].Material(name='Aluminum')
mdb.models['Model-1'].materials['Aluminum'].Density(table=((2700.0, ), ))
mdb.models['Model-1'].materials['Aluminum'].Elastic(table=((69000000000.0, 
    0.33), ))
mdb.models['Model-1'].CircularProfile(name='WireProfile', r=0.0015)
mdb.models['Model-1'].BeamSection(beamSectionOffset=(0.0, 0.0), 
    consistentMassMatrix=False, integration=DURING_ANALYSIS, material='Nitinol'
    , name='WireSection', poissonRatio=0.0, profile='WireProfile', 
    temperatureVar=LINEAR)
mdb.models['Model-1'].HomogeneousSolidSection(material='Aluminum', name=
    'HubSection', thickness=None)
mdb.models['Model-1'].parts['Hub'].Set(cells=
    mdb.models['Model-1'].parts['Hub'].cells, name='HubSet')
mdb.models['Model-1'].parts['Hub'].SectionAssignment(offset=0.0, offsetField=''
    , offsetType=MIDDLE_SURFACE, region=
    mdb.models['Model-1'].parts['Hub'].sets['HubSet'], sectionName='HubSection'
    , thicknessAssignment=FROM_SECTION)
mdb.models['Model-1'].parts['SMAWire'].Set(edges=
    mdb.models['Model-1'].parts['SMAWire'].edges.findAt(((-0.897537918740769, 
